# Copy to .env and fill in real values. Never commit .env.

# --- Database (Prisma / Postgres) ---
DATABASE_URL="postgresql://user:password@localhost:5432/love_bond"
POSTGRES_URL="postgresql://user:password@localhost:5432/love_bond"
PRISMA_DATABASE_URL="postgresql://user:password@localhost:5432/love_bond"

# --- Auth ---
JWT_SECRET="replace-with-a-long-random-string"

# --- fotochat upstream API ---
API_KEY="your-fotochat-api-key"
API_URL="https://api.example-fotochat.com"

# --- App URLs ---
BACKEND_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# --- Payments (secure processor) ---
SECURE_PROCESSOR_SHOP_ID=""
SECURE_PROCESSOR_SECRET_KEY=""
SECURE_PROCESSOR_PUBLIC_KEY=""
SECURE_PROCESSOR_API_BASE_URL=""
SECURE_PROCESSOR_CHECKOUT_TOKEN_PATH=""

# --- Mail ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="no-reply@example.com"
EMAIL_FROM_NAME="Love Bond"

# --- Demo activity simulation ---
# Powers simulated persona replies. Without it the reply cron logs an error and retries later;
# nothing else in the app is affected.
OPENAI_API_KEY="sk-..."
# Shared secret required by /api/cron/*. Vercel Cron sends it as "Authorization: Bearer <secret>".
CRON_SECRET="replace-with-a-long-random-string"
# fotochat account the seed cron logs in as to browse the public member pool.
# This account is excluded from persona harvesting, as are all registered love-bond users.
CRON_SERVICE_USERNAME=""
CRON_SERVICE_PASSWORD=""
